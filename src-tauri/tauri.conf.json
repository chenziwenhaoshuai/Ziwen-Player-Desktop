{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ziwen-Player",
  "version": "1.0.24",
  "identifier": "com.yfvod.tv.ziwenplayer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "子文播放器",
        "width": 1320,
        "height": 780,
        "minWidth": 360,
        "minHeight": 240,
        "resizable": true,
        "backgroundColor": "#101318"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
